# API Keys
GEMINI_API_KEY=

# Backend ASR/MT Services
VITE_ASR_MT_WS_URL=ws://localhost:8001/ws/asr-mt
VITE_ASR_MT_HTTP_URL=http://localhost:8001

# WebRTC Signaling Peer Server (auto-configured by default)
VITE_PEER_SERVER_HOST=
VITE_PEER_SERVER_PORT=3000
VITE_PEER_SERVER_PATH=/peerjs
VITE_PEER_SERVER_SECURE=true

# Translation & Audio Configuration
VITE_TRANSLATION_STREAM_PROVIDER=gemini-live
VITE_CALL_TOPOLOGY=p2p
