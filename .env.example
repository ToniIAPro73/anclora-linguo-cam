# API Keys
GEMINI_API_KEY=

# Backend ASR/MT Services
VITE_ASR_MT_WS_URL=ws://127.0.0.1:3021/ws/asr-mt
VITE_ASR_MT_HTTP_URL=http://127.0.0.1:3021

# WebRTC Signaling Peer Server (auto-configured by default)
PEER_HOST=127.0.0.1
PEER_PORT=3022
VITE_PEER_SERVER_HOST=127.0.0.1
VITE_PEER_SERVER_PORT=3022
VITE_PEER_SERVER_PATH=/peerjs
VITE_PEER_SERVER_SECURE=false

# Translation & Audio Configuration
VITE_TRANSLATION_STREAM_PROVIDER=gemini-live
VITE_CALL_TOPOLOGY=p2p
